# Addition using list
print("Addition using list:")
l1 = [[1,2,3],[4,5,6]]
l2 = [[1,0,0],[0,0,1]]
result1=[[0,0,0],[0,0,0]]
for i in range(len(l1)):
    for j in range(len(l1[0])):
        result1[i][j]=l1[i][j]+l2[i][j]
print("Matrix 1:")
for i in l1:
    print(i)
print("Matrix 2:")
for i in l2:
    print(i)
print("Addition of matrix 1 and matrix 2:")
for i in result1:
    print(i)
print("----------------------x--------------------x---------------------")
print("Addition using numpy module:")
import numpy as np
arr1 = np.array([[1,2,3],[4,5,6]])
arr2 = np.array([[1,0,0],[0,0,1]])
result2 = arr1+arr2
print("Matrix 1:\n",arr1)
print("Matrix 2:\n",arr2)
print("Addition of matrix 1 and matrix 2:\n",result2)

